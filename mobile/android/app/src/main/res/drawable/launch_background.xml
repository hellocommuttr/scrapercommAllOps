<?xml version="1.0" encoding="utf-8"?>
<!-- What a rider sees for the moment before Flutter paints. Commuttr's mark on white;
     the dark-mode copy in drawable-night puts it on black. It used to be a blank white
     screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark_light" />
    </item>
</layer-list>
